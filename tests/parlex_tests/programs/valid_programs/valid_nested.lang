i32 main() {
    i32 i = 0;
    while (i < 10) {
        if (i == 0) {
            prints("zero");
        } elif (i < 5) {
            prints("small");
            if (i == 3) {
                prints("three");
            }
        } else {
            prints("big");
            while (i > 7) {
                i -= 1;
            }
        }
        i += 1;
    }
    return 0;
}